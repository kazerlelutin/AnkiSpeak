{
  "name": "anki-speak",
  "version": "0.0.6",
  "module": "index.ts",
  "description": "Anki card generator with voice",
  "type": "module",
  "private": true,
  "author": {
    "name": "Benoist \"Kazerlelutin\" Bouteiller",
    "email": "bento@ik.me",
    "url": "https://kazerlelutin.space"
  },
  "scripts": {
    "dev": "bun run --hot --watch index.ts app.ts",
    "build": "bun build ./src/app.ts --outfile ./public/hydrate.mjs --format esm --minify --target browser && bun build --compile --minify ./index.ts --outfile ankispeak --target bun"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
